# Copy to .env and fill in your keys.
# .env itself is gitignored; .env.example is checked in.
#
# Only set the keys for providers you actually run probes against.
# The all-stub demos (`python -m examples.demo`,
# `python -m examples.demo_atlas`) and the live lab demo
# (`python -m examples.demo_atlas_live`) need NO API keys.

# Anthropic — for probes against Haiku 4.5 / Opus 4.7
ANTHROPIC_API_KEY=

# OpenAI — for probes against GPT-4o / GPT-4o-mini
OPENAI_API_KEY=

# Google — for probes against Gemini (free tier has 5 RPM limit)
GEMINI_API_KEY=

# xAI — for probes against Grok models
XAI_API_KEY=
